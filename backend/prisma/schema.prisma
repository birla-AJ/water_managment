// WaterFlow ERP — Prisma schema
// Water Distribution Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

// UI + message language preference (per user). en = English, hi = Hindi.
enum Language {
  en
  hi
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  DAILY
  WEEKLY
  MONTHLY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OrderType {
  REGULAR
  EXTRA
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum InventoryAction {
  STOCK_IN
  FILLED
  EMPTIED
  ALLOCATED
  RETURNED
  DAMAGED
  LOST
  ADJUSTMENT
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  CASH
  UPI
  CARD
  ADJUSTMENT
}

enum ExpenseCategory {
  FUEL
  VEHICLE_MAINTENANCE
  SALARY
  RENT
  UTILITIES
  SUPPLIES
  DELIVERY
  OTHER
}

enum NotificationAudience {
  ADMIN
  CUSTOMER
  DRIVER
}

enum NotificationType {
  ORDER_ACCEPTED
  ORDER_DELIVERED
  BILL_GENERATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_DUE_REMINDER
  NEW_CUSTOMER
  NEW_ORDER_REQUEST
  PAYMENT_RECEIVED
  INVENTORY_LOW
  DRIVER_ASSIGNED
  DELIVERY_ASSIGNED
  CUSTOMER_SKIPPED
  DELIVERY_REQUESTED
  DELIVERY_CANCELLED
  GENERAL
}

// Who created a delivery request for a date.
enum RequestSource {
  CUSTOMER
  ADMIN
}

// ============================================================
// MODELS
// ============================================================

model Admin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  phone        String?
  // Optional mobile number for OTP login from the mobile app. Unique so a number
  // resolves to exactly one admin during /auth/otp/verify.
  mobile       String?   @unique
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  language     Language  @default(en) // preferred UI + message language

  // ── Distributor service definition ──────────────────────────────────────
  // A regular ADMIN acts as a distributor for an area. Customers are matched to
  // distributors by GPS radius, pincode, or service-area name (any may apply).
  latitude        Float?
  longitude       Float?
  serviceRadiusKm Float?   @default(5) // GPS match radius around (latitude, longitude)
  pincodes        String[] @default([]) // pincodes this distributor serves
  serviceAreas    String[] @default([]) // free-text locality tags served (e.g. ["Limbodi","Bhawarkua"])

  refreshTokens RefreshToken[]
  inventoryLogs InventoryLog[]
  ownedDrivers Driver[] @relation("AdminDrivers")
  ownedVehicles Vehicle[] @relation("AdminVehicles")
  notifications Notification[] @relation("AdminNotifications")
  expenses      Expense[]
  customers     Customer[]     @relation("AdminCustomers")          // created by this admin (audit)
  distributedCustomers Customer[] @relation("DistributorCustomers") // customers who chose this distributor
  areaLinks     ServiceArea[]  @relation("AdminServiceAreas")        // areas assigned from the master list
  servicePolygons ServiceAreaPolygon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("admins")
}

// Master list of service areas/localities, maintained by the super-admin. Admins
// can be linked to any number of these for consistent, deduplicated area names
// (complements the free-text Admin.serviceAreas tags).
model ServiceArea {
  id        String  @id @default(uuid())
  name      String  @unique
  city      String?
  pincode   String?
  latitude  Float?
  longitude Float?

  admins Admin[] @relation("AdminServiceAreas")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_areas")
}

// A delivery driver. Logs into the mobile app with the same phone+OTP flow as a
// customer; the backend detects a registered driver number and routes them to
// the driver dashboard. Admin assigns a vehicle, a zone, and a set of customers.
model Driver {
  id            String       @id @default(uuid())
  name          String
  mobile        String       @unique
  email         String?
  licenseNumber String?
  address       String?
  zone          String?
  status        DriverStatus @default(ACTIVE)
  fcmToken      String?
  language      Language     @default(en) // preferred UI + message language
  // Set when an admin removes the driver (soft delete). Non-null = removed:
  // hidden from lists and blocked from logging in.
  blockedAt     DateTime?
  vehicleId     String?      @unique
  // The regular admin/distributor who owns this driver.
  adminId       String?
  isOnDuty      Boolean      @default(false)
  dutyStartedAt DateTime?
  lastSeenAt    DateTime?

  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  admin         Admin?         @relation("AdminDrivers", fields: [adminId], references: [id], onDelete: SetNull)
  customers     Customer[]
  deliveries    Delivery[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  locations     DriverLocation[]
  dutySessions  DriverDutySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([zone])
  @@index([isOnDuty])
  @@index([adminId])
  @@map("drivers")
}

// Driver GPS pings while the driver has duty enabled in the mobile app.
// Customers can see exact location only for their active assigned delivery.
model DriverLocation {
  id           String   @id @default(uuid())
  driverId     String
  latitude     Float
  longitude    Float
  accuracy     Float?
  speed        Float?
  heading      Float?
  batteryLevel Float?
  recordedAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt])
  @@map("driver_locations")
}

// Duty sessions make it easy to understand which driver was on duty,
// when they started, and when they left duty.
model DriverDutySession {
  id        String    @id @default(uuid())
  driverId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startedAt])
  @@index([endedAt])
  @@map("driver_duty_sessions")
}

// GeoJSON polygon boundaries for distributor service coverage.
// A regular admin manages their own polygons; super admin can manage all.
model ServiceAreaPolygon {
  id        String  @id @default(uuid())
  adminId   String
  name      String
  geoJson   Json
  color     String  @default("#0E8C84")
  isActive  Boolean @default(true)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([isActive])
  @@map("service_area_polygons")
}

// Delivery vehicle managed by admin and (optionally) assigned to one driver.
model Vehicle {
  id       String  @id @default(uuid())
  number   String  @unique
  type     String?
  capacity Int?
  isActive Boolean @default(true)
  notes    String?
  // The regular admin/distributor who owns this vehicle.
  adminId  String?

  driver Driver?
  admin  Admin? @relation("AdminVehicles", fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
  @@index([adminId])
}

model Customer {
  id              String         @id @default(uuid())
  name            String
  mobile          String         @unique
  email           String?
  address         String?
  area            String?
  landmark        String?
  pincode         String?
  // Geocoordinates of the customer's delivery location (used for distributor matching).
  latitude        Float?
  longitude       Float?
  customerType    CustomerType   @default(DAILY)
  status          CustomerStatus @default(ACTIVE)
  // Set when an admin removes the customer (soft delete). Non-null = removed:
  // hidden from lists and blocked from logging in. Data is preserved.
  blockedAt       DateTime?
  securityDeposit Decimal        @default(0) @db.Decimal(10, 2)
  ratePerCamper   Decimal        @default(0) @db.Decimal(10, 2)
  allocatedCampers Int           @default(0)
  notes           String?
  fcmToken        String?
  language        Language       @default(en) // preferred UI + message language
  // Pause feature
  isPaused        Boolean        @default(false)
  pausedFrom      DateTime?
  pausedTo        DateTime?
  // Driver responsible for delivering to this customer (assigned by admin).
  driverId        String?
  // Admin who created / manages this customer (null for self-signups via OTP).
  createdById     String?
  // Distributor (admin) the customer is assigned to — chosen at registration or
  // by the admin who creates them. Scopes which dashboard the customer appears on.
  distributorId   String?

  driver        Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdBy     Admin?             @relation("AdminCustomers", fields: [createdById], references: [id], onDelete: SetNull)
  distributor   Admin?             @relation("DistributorCustomers", fields: [distributorId], references: [id], onDelete: SetNull)
  schedules     CustomerSchedule[]
  orders        Order[]
  deliveries    Delivery[]
  invoices      Invoice[]
  payments      Payment[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  deliveryRequests DeliveryRequest[]
  aiChatUsages AiChatUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([area])
  @@index([customerType])
  @@index([driverId])
  @@index([createdById])
  @@index([distributorId])
  @@index([pincode])
  @@map("customers")
}

// Legacy customer AI-chat usage counter kept for existing deployments.
model AiChatUsage {
  id         String   @id @default(uuid())
  customerId String
  date       DateTime @db.Date
  count      Int      @default(0)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, date])
  @@index([date])
  @@map("ai_chat_usages")
}

// Daily AI-chat usage counter for every account type that can use WaterFlow AI.
model AiDailyUsage {
  id          String   @id @default(uuid())
  principal   String
  principalId String
  date        DateTime @db.Date
  count       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([principal, principalId, date])
  @@index([principal, principalId])
  @@index([date])
  @@map("ai_daily_usages")
}

// Specific dates a customer asked to receive water on (opt-in).
// Deliveries are opt-in: a date with no row here means "no delivery". The
// regular-order generator only creates an order for dates listed here.
model DeliveryRequest {
  id         String   @id @default(uuid())
  customerId String
  date       DateTime @db.Date
  // Who marked the day: the customer from their app, or an admin on their behalf.
  source     RequestSource @default(CUSTOMER)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, date])
  @@index([date])
  @@map("delivery_requests")
}

// Per-weekday default camper quantity. Since deliveries became opt-in
// (DeliveryRequest), `enabled` no longer decides whether a delivery happens —
// it only marks the weekday the customer usually takes water, and `quantity` is
// the number of campers used when an order is generated for that weekday.
model CustomerSchedule {
  id         String   @id @default(uuid())
  customerId String
  weekday    Weekday
  enabled    Boolean  @default(true)
  quantity   Int      @default(1)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, weekday])
  @@map("customer_schedules")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  customerId  String
  type        OrderType   @default(REGULAR)
  status      OrderStatus @default(PENDING)
  quantity    Int         @default(1)
  orderDate   DateTime    @db.Date
  remarks     String?

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      OrderItem[]
  delivery   Delivery?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([type])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  name      String  @default("Water Camper (20L)")
  quantity  Int     @default(1)
  rate      Decimal @default(0) @db.Decimal(10, 2)
  amount    Decimal @default(0) @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Delivery {
  id                String         @id @default(uuid())
  orderId           String         @unique
  customerId        String
  status            DeliveryStatus @default(PENDING)
  deliveryDate      DateTime?      @db.Date
  quantityDelivered Int            @default(0)
  emptyCollected    Int            @default(0)
  remarks           String?
  // Driver who fulfilled (or is assigned to) this delivery.
  driverId          String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver   Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([deliveryDate])
  @@index([driverId])
  @@map("deliveries")
}

// Each admin/distributor has an independent inventory snapshot. The nullable
// legacy row (adminId = NULL) remains visible only to super admins.
model Inventory {
  id              String @id @default("default")
  totalCampers    Int    @default(0)
  filledCampers   Int    @default(0)
  emptyCampers    Int    @default(0)
  damagedCampers  Int    @default(0)
  lostCampers     Int    @default(0)
  returnedCampers Int    @default(0)
  allocatedCampers Int   @default(0)
  adminId         String? @unique

  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model InventoryLog {
  id       String          @id @default(uuid())
  action   InventoryAction
  quantity Int
  remarks  String?
  adminId  String?

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("inventory_logs")
}

// Operating expenses are owned by the admin/distributor who created them.
model Expense {
  id          String          @id @default(uuid())
  adminId     String
  title       String
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @db.Date
  paymentMode PaymentMethod   @default(CASH)
  notes       String?

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, expenseDate])
  @@index([category])
  @@map("expenses")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  periodStart   DateTime      @db.Date
  periodEnd     DateTime      @db.Date
  quantity      Int           @default(0)
  rate          Decimal       @default(0) @db.Decimal(10, 2)
  subTotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  dueAmount     Decimal       @default(0) @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime?     @db.Date
  pdfUrl        String?
  notes         String?

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  rate        Decimal @default(0) @db.Decimal(10, 2)
  amount      Decimal @default(0) @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(uuid())
  customerId        String
  invoiceId         String?
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(RAZORPAY)
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpaySignature String?
  refundId          String?
  notes             String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model Notification {
  id         String               @id @default(uuid())
  audience   NotificationAudience
  type       NotificationType     @default(GENERAL)
  title      String
  body       String
  data       Json?
  customerId String?
  driverId   String?
  // Admin notifications are addressed to one admin, never broadcast to all
  // tenant administrators. Null is reserved for legacy/super-admin notices.
  adminId    String?
  isRead     Boolean              @default(false)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  admin    Admin?    @relation("AdminNotifications", fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([audience])
  @@index([customerId])
  @@index([driverId])
  @@index([adminId])
  @@index([isRead])
  @@map("notifications")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  adminId    String?
  customerId String?
  driverId   String?
  expiresAt  DateTime
  revoked    Boolean  @default(false)

  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([customerId])
  @@index([driverId])
  @@map("refresh_tokens")
}

// OTP store for customer login
model OtpCode {
  id        String   @id @default(uuid())
  mobile    String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([mobile])
  @@map("otp_codes")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
