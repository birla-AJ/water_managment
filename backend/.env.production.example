# ===== Production env for EC2 — copy to `.env` and fill in real values =====
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Public origins allowed to call the API (admin dashboard + any web client).
# Use your real domain/IP. Comma-separated, no spaces.
CORS_ORIGINS=http://35.154.198.189,http://localhost:5173

# ===== Database (local PostgreSQL on the EC2 box) =====
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# NOTE: if the password contains @ : / it must be URL-encoded (@ -> %40).
DATABASE_URL=postgresql://waterflow:CHANGE_ME@localhost:5432/waterflow?schema=public

# ===== JWT — generate with: openssl rand -hex 32 =====
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== OTP =====
OTP_DEV_CODE=123456
OTP_EXPIRES_MINUTES=5
# Set true to keep login working with the fixed OTP_DEV_CODE (no SMS needed),
# even while NODE_ENV=production. Set false once a real SMS provider is wired.
OTP_TEST_MODE=true

# ===== SMS gateway (for real OTP delivery) =====
# SMS_PROVIDER: msg91 | fast2sms | twilio | console  (console = log only, no real SMS)
SMS_PROVIDER=console
SMS_SENDER_ID=
# -- MSG91 (recommended for India) --
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# -- Fast2SMS --
FAST2SMS_API_KEY=
FAST2SMS_MESSAGE_ID=
# -- Twilio --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ===== Razorpay (optional — leave blank to disable) =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===== Firebase push (optional — leave blank to disable) =====
FIREBASE_SERVICE_ACCOUNT_PATH=

# ===== Uploads =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== Inventory =====
INVENTORY_LOW_THRESHOLD=20

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
