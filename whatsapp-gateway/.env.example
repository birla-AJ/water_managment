# Copy to .env and fill in

# HTTP
PORT=4000

# Per-project API keys -> ONE gateway serves many projects, each scoped to its
# own numbers. Format: project:key , comma separated. CHANGE THE KEYS.
#   school-erp uses key1, dxmart uses key2, etc.
API_KEYS=school-erp:CHANGE_ME_long_random_1,dxmart:CHANGE_ME_long_random_2

# Storage (created automatically)
DATA_DIR=./data
SESSIONS_DIR=./sessions

# --- Safe-sender knobs ---
SEND_MIN_DELAY_MS=3000
SEND_MAX_DELAY_MS=8000

# Only send during these local hours (24h). Outside this, queue waits.
ACTIVE_HOURS_START=9
ACTIVE_HOURS_END=20
# Local timezone offset in minutes (IST = 330).
TIMEZONE_OFFSET_MIN=330

# Verify recipient is on WhatsApp before sending.
CHECK_ON_WHATSAPP=true

# Warm-up: max messages per number per day, by day-since-first-connect.
WARMUP_CAPS=30,60,120,250,500,1000

LOG_LEVEL=warn

# Inbound: forward incoming messages to each project's app. Split on FIRST '='
# (URLs contain ':'). Comma-separate multiple projects.
WEBHOOKS=school-erp=http://localhost:5000/api/whatsapp-webhook/incoming
# Shared secret sent as x-webhook-secret (the app verifies it). CHANGE THIS.
WEBHOOK_SECRET=CHANGE_ME_webhook_secret
